# ==============================================================================
# AlexaX — Your Personal AI Agent: Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3001
HOST=0.0.0.0

# AI Provider Selection:
# Options: 'mock' (default, no API key needed), 'gemini', or 'openai'
LLM_PROVIDER=mock

# Google Gemini API Key (Optional: only needed if LLM_PROVIDER=gemini)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Optional: only needed if LLM_PROVIDER=openai)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# SQLite Data Directory (Defaults to ./data)
DATA_DIR=./data
